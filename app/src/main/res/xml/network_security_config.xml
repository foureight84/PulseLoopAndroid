<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP, for the "Local / self-hosted" AI Coach provider only in practice.

  A user's own inference server (Ollama on 11434, llama.cpp on 8080, vLLM on 8000, SGLang on
  30000, LM Studio on 1234) sits on the LAN with no TLS certificate, so every request to it would
  otherwise fail with CleartextNotPermitted — Android has blocked cleartext by default since
  API 28.

  Network Security Config has no CIDR syntax, so "permit cleartext to private addresses only"
  cannot be expressed here. The restriction is enforced one layer up instead, in
  LocalEndpoint.validate: a plain http:// URL is accepted only for loopback, RFC1918, CGNAT,
  link-local, or a local-only name (*.local, *.lan, *.ts.net, a bare hostname), and anything on
  the public internet must be https://. Every cloud provider endpoint in the app is a hardcoded
  https:// constant and is unaffected by this file.

  Know what that layering does NOT cover on its own: validate() vets the URL the user typed, not
  the one a request ends up on. With cleartext permitted app-wide, a 307 from the validated LAN
  host to a public http:// one would resend the coach's health-context POST body in the clear.
  The local provider therefore sends with redirects disabled (ResponsesHttp.clientFor,
  followRedirects = false) — that is the other half of this restriction, not an optimisation.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
